{
  "name": "@kin0992/tsconfig",
  "version": "0.1.1",
  "description": "Shared TypeScript configurations for dev-toolkit consumers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kin0992/dev-toolkit.git",
    "directory": "packages/tsconfig"
  },
  "files": [
    "base.json",
    "node.json",
    "library.json",
    "README.md"
  ],
  "type": "module",
  "exports": {
    "./base": "./base.json",
    "./node": "./node.json",
    "./library": "./library.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:check": "oxlint"
  },
  "devDependencies": {
    "@kin0992/oxc-config": "workspace:*",
    "@tsconfig/node24": "^24.0.4",
    "oxfmt": "catalog:core",
    "oxlint": "catalog:core"
  }
}
