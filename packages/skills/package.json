{
  "name": "@kin0992/skills",
  "version": "0.0.2",
  "description": "AI Skills bundle: commit messages and PR title/description.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kin0992/dev-toolkit.git",
    "directory": "packages/skills"
  },
  "files": [
    "src/**",
    "README.md"
  ],
  "type": "module",
  "exports": {
    "./commit-message": "./src/commit-message/SKILL.md",
    "./pr-title-description": "./src/pr-title-description/SKILL.md"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
