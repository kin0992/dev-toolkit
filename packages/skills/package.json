    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:check": "oxlint"
  },
  "devDependencies": {
    "@kin0992/oxc-config": "workspace:*",
    "oxfmt": "catalog:core",
    "oxlint": "catalog:core"
  }
