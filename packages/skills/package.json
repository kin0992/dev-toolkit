    "./changelog-summary": "./src/changelog-summary/SKILL.md"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "format:check": "oxfmt --check",
    "format": "oxfmt --write"
  }
