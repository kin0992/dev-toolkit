{
  "name": "dev-toolkit-infra",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "index.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt --config oxfmt.config.mjs",
    "format:check": "oxfmt --check --config oxfmt.config.mjs",
    "lint": "oxlint -c oxlint.config.mjs --fix",
    "lint:check": "oxlint -c oxlint.config.mjs",
    "test": "echo 'no infra tests'",
    "preview": "pulumi preview",
    "up": "pulumi up",
    "drift": "pulumi preview --expect-no-changes --diff"
  },
  "dependencies": {
    "@pulumi/github": "^6.13.1",
    "@pulumi/pulumi": "^3.140.0"
  },
  "devDependencies": {
    "@kin0992/oxc-config": "workspace:*",
    "@types/node": "^22.10.2",
    "oxfmt": "catalog:core",
    "oxlint": "catalog:core",
    "typescript": "^5.7.2"
  }
}
