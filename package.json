{
  "name": "dev-toolkit",
  "version": "0.0.0",
  "private": true,
  "description": "Platform Engineering toolkit: reusable GitHub Actions, AI Skills, and shared TypeScript configs.",
  "license": "MIT",
  "author": "kin0992",
  "repository": {
    "type": "git",
    "url": "https://github.com/kin0992/dev-toolkit.git"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:check": "turbo run lint:check",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "turbo run test && pnpm test:skills",
    "typecheck": "turbo run typecheck",
    "code-review": "pnpm format:check && pnpm typecheck && pnpm lint:check && pnpm lint:skills && pnpm test && pnpm marketplace:check && pnpm skills:check",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm marketplace:sync",
    "release": "turbo run build && changeset publish",
    "marketplace:sync": "node scripts/sync-marketplace.mjs",
    "marketplace:check": "node scripts/sync-marketplace.mjs --check",
    "skills:sync": "node scripts/sync-skills.mjs",
    "skills:check": "node scripts/sync-skills.mjs --check",
    "test:skills": "vitest run scripts/sync-skills.test.mjs",
    "lint:skills": "oxlint scripts/sync-skills.mjs scripts/sync-skills.test.mjs scripts/copilot-readonly.js"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@kin0992/oxc-config": "workspace:*",
    "oxfmt": "catalog:core",
    "oxlint": "catalog:core",
    "turbo": "^2.11.10",
    "typescript": "catalog:core",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.28.11+sha512.740184d10f81f5d5b165be88560ee7ba62406c4134896abc27a580109eec2f47c1e41d91251c944c2cababcb1c22461799ebb72de2ec625af2030b0e36c735a3"
}
